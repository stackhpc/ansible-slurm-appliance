#!/usr/bin/env bash
#
# image-build.sh
#
# Runs a Packer build for this site with teed output while still preseverting
# default prompt behaviour on Ctrl+C

# Usage:
#   ./image-build.sh BUILD
 
set -euo pipefail

if [ "$#" -lt 1 ]; then
    echo "Usage: $0 <build>" >&2
    echo "Example: $0 base" >&2
    exit 1
fi

BUILD="$1"
VAR_FILE="environments/site/${BUILD}.pkrvars.hcl"
LOG_FILE="environments/site/${BUILD}.build.log"
PACKER_BIN="${PACKER_BIN:-packer}"
PACKER_ON_ERROR="${PACKER_ON_ERROR:-ask}"

# build the image:
"$PACKER_BIN" init packer/openstack.pkr.hcl
"$PACKER_BIN" build -color=false -on-error="$PACKER_ON_ERROR" \
    -var-file=environments/site/common.pkrvars.hcl \
    -var-file="$VAR_FILE" \
    packer/openstack.pkr.hcl | (trap '' INT; tee "$LOG_FILE")

# set properties:
IMAGE_ID=$(awk '/An image was created:/ {id=$NF} END {print id}' "$LOG_FILE")
if [ -z "$IMAGE_ID" ]; then
    echo "Could not find image ID in $LOG_FILE" >&2
    exit 1
fi
dev/image-set-properties.sh $IMAGE_ID

echo "done."
