#!/usr/bin/env bash
#
# image-build.sh
#
# Runs a Packer build for this site with teed output while still preseverting
# default prompt behaviour on Ctrl+C

# Usage:
#   ./image-build.sh BUILD
 
set -euo pipefail

if [ "$#" -lt 1 ]; then
    echo "Usage: $0 <build>" >&2
    echo "Example: $0 base" >&2
    exit 1
fi

BUILD="$1"
VAR_FILE="environments/site/${BUILD}.pkrvars.hcl"
LOG_FILE="environments/site/${BUILD}.build.log"
 
packer build -color=false -on-error=ask \
    -var-file=environments/site/common.pkrvars.hcl \
    -var-file="$VAR_FILE" \
    packer/openstack.pkr.hcl | (trap '' INT; tee "$LOG_FILE")
