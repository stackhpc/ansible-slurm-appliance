{% if slurmrestd_proxy_port_80_redirect_enabled %}
<VirtualHost *:80>
ServerName {{ slurmrestd_proxy_servername }}

RewriteEngine On
{# rewrite identical to certbot to avoid useless changes #}
RewriteCond %{SERVER_NAME} ={{ slurmrestd_proxy_servername }}
RewriteRule ^ https://%{SERVER_NAME}{% if slurmrestd_proxy_tls_port != 443 %}:{{ slurmrestd_proxy_tls_port }}{% endif %}%{REQUEST_URI} [END,NE,R=permanent]
</VirtualHost>
{% endif %}
<VirtualHost *:{{ slurmrestd_proxy_tls_port }}>
ServerName {{ slurmrestd_proxy_servername }}

ErrorLog  "/var/log/httpd/slurmrestd_proxy_error_ssl.log"
CustomLog "/var/log/httpd/slurmrestd_proxy_access_ssl.log" combined

TraceEnable off

Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

SSLEngine On
{% for option in slurmrestd_proxy_ssl_options %}
{{ option }}
{% endfor %}

ProxyPass "/" "http://{{ openhpc_slurmrestd_listen_endpoints | first }}/"
ProxyPassReverse "/" "http://{{ openhpc_slurmrestd_listen_endpoints | first }}/"
ProxyPreserveHost On

{% if slurmrestd_proxy_certbot and _slurmrestd_proxy_certbot.stat.exists %}
Include /etc/letsencrypt/options-ssl-apache.conf
SSLCertificateFile /etc/letsencrypt/live/{{ slurmrestd_proxy_servername }}/fullchain.pem
SSLCertificateKeyFile /etc/letsencrypt/live/{{ slurmrestd_proxy_servername }}/privkey.pem
{% else %}
SSLCertificateFile /etc/pki/tls/certs/localhost.crt
SSLCertificateKeyFile /etc/pki/tls/private/localhost.key
{% endif %}
</VirtualHost>
