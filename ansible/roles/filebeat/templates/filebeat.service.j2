# container-filebeat.service
# based off
#   podman generate systemd filebeat --restart-policy always --new --name
# uses Type=forking + --conmon-pidfile rather than --sdnotify=conmon, because
# systemd 239 (RL8) can drop podman's notify message ("Cannot find unit for
# notify message"), failing the start with result 'protocol'

[Unit]
Description=Podman container-filebeat.service
Documentation=man:podman-generate-systemd(1)
Wants=network-online.target
After=network-online.target

[Service]
Type=forking
# ensure the podman user can write the conmon pidfile:
RuntimeDirectory=filebeat
PIDFile=/run/filebeat/conmon.pid
Environment=PODMAN_SYSTEMD_UNIT=%n
Restart=always
ExecStart=/usr/bin/podman run \
    --network=host \
    --conmon-pidfile /run/filebeat/conmon.pid \
    --cgroups=no-conmon \
    --replace \
    --name filebeat \
    --user root \
    --security-opt label=disable \
    --volume /var/log/:/logs:ro \
    --volume /etc/filebeat/filebeat.yml:/usr/share/filebeat/filebeat.yml:ro \
    --detach=True docker.elastic.co/beats/filebeat-oss:{{ filebeat_version }} \
    -e -strict.perms=false -d "*"
ExecStop=/usr/bin/podman stop --ignore filebeat -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f filebeat
KillMode=none
NotifyAccess=none
User={{ filebeat_podman_user }}
Group={{ filebeat_podman_user }}
TimeoutStartSec=180
# filebeat exits 143 (128 + SIGTERM) when podman stop terminates it:
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target default.target
